{
  "name": "language-llm",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first YouTube language suite (extension + companion)",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --filter \"!@language-llm/extension-e2e\" build",
    "test": "pnpm -r --filter \"!@language-llm/extension-e2e\" test",
    "typecheck": "pnpm -r --filter \"!@language-llm/extension-e2e\" typecheck",
    "lint": "pnpm -r --filter \"!@language-llm/extension-e2e\" lint",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --skip-install --quick",
    "test:js": "pnpm -r --filter \"!@language-llm/extension\" --filter \"!@language-llm/extension-e2e\" test",
    "test:all": "pnpm -r --filter \"!@language-llm/extension-e2e\" test",
    "test:e2e": "pnpm --filter @language-llm/extension-e2e test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
